{
  "editor.formatOnSave": true,
  "[elixir]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls"
  },
  "[phoenix-heex]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls"
  },
  "files.associations": {
    "*.heex": "phoenix-heex"
  },
  "tailwindCSS.includeLanguages": {
    "phoenix-heex": "html",
    "elixir": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    ["class[:]\\s*\"([^\"]*)\"", "([a-zA-Z0-9\\-:\\/\\[\\]\\.]+)"]
  ],
  "emmet.includeLanguages": {
    "phoenix-heex": "html"
  }
}
